{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicVault",
  "version": "0.1.1",
  "identifier": "com.offlineplayer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MusicVault",
        "width": 1280,
        "height": 840,
        "minWidth": 320,
        "minHeight": 110,
        "center": true,
        "decorations": false
      },
      {
        "label": "tray_popup",
        "title": "MusicVault",
        "width": 228,
        "height": 360,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2OTNCQTIzMzY3QTA0MDcKUldRSEJIbzJJN3FUbHQ5QzZIUmFLUGQ4NFI5bDF1ZTMwUGhwMTQyMjJjdldaV2hlTHN4RTYzQVgK",
      "endpoints": [
        "https://github.com/gautamcoder235/Offline-player/releases/latest/download/latest.json"
      ]
    }
  }
}
